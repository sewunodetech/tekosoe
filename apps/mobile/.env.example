# Salin ke apps/mobile/.env — nilai EXPO_PUBLIC_* ikut ter-bundle ke app, jadi hanya nilai publik.
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
# AUSD (Agora) dan faucet-nya punya default di @tekosoe/shared; isi hanya kalau ingin menimpa.
EXPO_PUBLIC_AUSD_ADDRESS=
EXPO_PUBLIC_AUSD_FAUCET_ADDRESS=
# Default: GroupVault v1 testnet dari @tekosoe/shared
EXPO_PUBLIC_GROUP_VAULT_ADDRESS=
EXPO_PUBLIC_ENVIO_GRAPHQL_URL=
EXPO_PUBLIC_API_URL=
# Below this MON balance the app asks the api for a drip before a transaction (match DRIP_MIN_BALANCE_MON)
EXPO_PUBLIC_MIN_FEE_BALANCE_MON=0.05
EXPO_PUBLIC_PASSKEY_DOMAIN=tekosoe.xyz
# Domain tautan undangan (/j/<kode>) dan verifikasi invoice (/v/<nomor>) — apps/web
EXPO_PUBLIC_WEB_DOMAIN=tekosoe.xyz
# Penerima "toko demo" di layar Pay (testnet). Pakai alamat yang dikuasai tim.
EXPO_PUBLIC_DEMO_SHOP_ADDRESS=
# "Bank" demo untuk Cash out (simulasi off-ramp, ADR 0006). Kosong = pakai alamat toko demo.
EXPO_PUBLIC_CASH_OUT_ADDRESS=
# Jeda keberatan + jeda sebelum settle setelah tanggal berakhir (detik). Demo: pendek.
EXPO_PUBLIC_DISPUTE_WINDOW_SECONDS=3600
# demo | live — sumber data layar (live: Envio + api + GroupVault di testnet)
EXPO_PUBLIC_DATA_SOURCE=demo
# mera | demo — penanda tangan (default: demo di web, mera di HP; mera butuh dev build).
# demo = kunci acak khusus perangkat (bisa bertransaksi di testnet, jangan untuk dana sungguhan).
EXPO_PUBLIC_SIGNER=
