# Salin ke apps/mobile/.env — nilai EXPO_PUBLIC_* ikut ter-bundle ke app, jadi hanya nilai publik.
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_AUSD_ADDRESS=
EXPO_PUBLIC_GROUP_VAULT_ADDRESS=
EXPO_PUBLIC_ENVIO_GRAPHQL_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PASSKEY_DOMAIN=tekosoe.app
# demo | live — sumber data layar (live butuh Envio + api, WP M6)
EXPO_PUBLIC_DATA_SOURCE=demo
# mera | demo — penanda tangan (default: demo di web, mera di HP; mera butuh dev build)
EXPO_PUBLIC_SIGNER=
