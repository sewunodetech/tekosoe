# Semua opsional; default di src/lib/site.ts. Nilai NEXT_PUBLIC_* ter-inline saat build (static export),
# jadi ganti nilai = build ulang image web.
NEXT_PUBLIC_SITE_URL=https://www.tekosue.xyz
# apps/api publik: nama trip (/api/groups/:id/meta) dan invoice bertoken (/api/invoices/:number?token=)
NEXT_PUBLIC_API_URL=https://api.mulalabs.biz.id
# Envio (Hasura) GraphQL publik: data trip untuk /j dan data settle untuk /v
NEXT_PUBLIC_ENVIO_GRAPHQL_URL=https://graphql.mulalabs.biz.id/v1/graphql
NEXT_PUBLIC_ANDROID_APK_URL=
# Tujuan tombol "Get the app" (default: halaman /get-app)
NEXT_PUBLIC_APP_DOWNLOAD_URL=
