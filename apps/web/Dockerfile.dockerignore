apps/mobile/**
!apps/mobile/package.json
packages/contracts/**
!packages/contracts/package.json
packages/indexer/**
!packages/indexer/package.json
apps/web/.next
apps/web/.expo
apps/web/Dockerfile
apps/web/Dockerfile.dockerignore
