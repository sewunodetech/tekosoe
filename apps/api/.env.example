# Copy to .env and fill in. No real secrets belong in this file — .env is gitignored.
NODE_ENV=production
PORT=3000
# Origin browser yang boleh memanggil api (web www.tekosue.xyz + dev lokal). Jangan kosong di produksi (kosong = terbuka).
CORS_ORIGINS=https://www.tekosue.xyz,https://tekosue.xyz,http://localhost:3000
ADMIN_API_KEY=

# chain
CHAIN_ID=10143
MONAD_TESTNET_RPC_URL=
GROUP_VAULT_ADDRESS=0x02Fb964B6b4470C14D61738EC0a296fa9F2dbCE0
AUSD_ADDRESS=
ENVIO_GRAPHQL_URL=

# wallets (harus berbeda)
DRIP_PRIVATE_KEY=
SETTLER_PRIVATE_KEY=
LOW_BALANCE_THRESHOLD_MON=0.5

# drip
# ~100 gwei di Monad testnet: 1 aksi user ≈ 0.01–0.03 MON; alur demo ≈ 6 aksi
DRIP_AMOUNT_MON=0.2
DRIP_MIN_BALANCE_MON=0.05
DRIP_RATE_LIMIT_PER_HOUR=5
DRIP_DAILY_CAP=200
DRIP_REFILL_COOLDOWN_MINUTES=30

# settle scheduler
SETTLE_INTERVAL_MS=30000
SETTLE_ALERT_ATTEMPTS=8

# database (pooled untuk app, direct untuk migrasi pre-deploy)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# auth
AUTH_DOMAIN=www.tekosue.xyz
AUTH_JWT_SECRET=
AUTH_TOKEN_TTL_SECONDS=3600

# P2 (aktif kalau FEATURE_RECEIPTS=true)
FEATURE_RECEIPTS=false
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
RECEIPT_MAX_BYTES=5242880
RECEIPT_VERIFY_HASH=true

# Push notification (ADR 0014). Event dibaca dari Envio; FEATURE_PUSH=true mengirim push lewat Expo.
FEATURE_PUSH=false
EXPO_ACCESS_TOKEN=            # opsional, hanya kalau enhanced push security aktif
NOTIFY_SOURCE=envio           # envio (default) | alchemy (opsional, butuh ALCHEMY_WEBHOOK_SIGNING_KEY)
NOTIFY_INTERVAL_MS=15000
DEBT_REMINDER_HOURS=24
ALCHEMY_WEBHOOK_SIGNING_KEY=
