# Salin ke .env di masing-masing app. Jangan pernah commit .env.

# apps/mobile (Expo; hanya nilai publik — ikut ter-bundle ke app)
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_AUSD_ADDRESS=
EXPO_PUBLIC_GROUP_VAULT_ADDRESS=
EXPO_PUBLIC_ENVIO_GRAPHQL_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PASSKEY_DOMAIN=

# apps/api (backend, rahasia) — daftar lengkap ada di apps/api/.env.example
# (RPC, GroupVault, Envio, kunci drip/settler, DATABASE_URL, auth JWT, S3 struk, push).

# packages/contracts (deploy)
DEPLOYER_PRIVATE_KEY=        # akun testnet khusus deploy, jangan dipakai untuk hal lain
AUSD_ADDRESS=
