# Salin ke .env di masing-masing app. Jangan pernah commit .env.

# apps/mobile (Expo; hanya nilai publik — ikut ter-bundle ke app)
EXPO_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
EXPO_PUBLIC_AUSD_ADDRESS=
EXPO_PUBLIC_GROUP_VAULT_ADDRESS=
EXPO_PUBLIC_ENVIO_GRAPHQL_URL=
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_PASSKEY_DOMAIN=

# apps/web (Next.js; hanya nilai publik)
NEXT_PUBLIC_APP_DOWNLOAD_URL=  # opsional: tujuan tombol "Get the app" (default: halaman /get-app)

# apps/api (backend, rahasia)
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
GROUP_VAULT_ADDRESS=
DATABASE_URL=                # Postgres (Neon/Supabase) — hanya di backend, jangan pernah di app
RECEIPTS_STORAGE_ENDPOINT=   # object storage untuk ciphertext struk (S3-compatible)
RECEIPTS_STORAGE_BUCKET=receipts
RECEIPTS_STORAGE_ACCESS_KEY=
RECEIPTS_STORAGE_SECRET_KEY=
EXPO_ACCESS_TOKEN=           # kirim push lewat Expo
ALCHEMY_API_KEY=             # opsional
ALCHEMY_GAS_POLICY_ID=       # opsional

# packages/contracts (deploy)
DEPLOYER_PRIVATE_KEY=        # akun testnet khusus deploy, jangan dipakai untuk hal lain
AUSD_ADDRESS=
