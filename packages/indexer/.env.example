# Salin ke packages/indexer/.env (gitignored). Envio hanya membaca variabel berawalan ENVIO_.
# Nilai chain/kontrak punya default di config.yaml (GroupVault v1 di Monad testnet).

# HyperSync (sumber data utama). Gratis: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Kontrak & chain — isi hanya kalau deploy ulang / pindah jaringan
ENVIO_CHAIN_ID=10143
ENVIO_GROUP_VAULT_ADDRESS=0x1467c9de54C1e4570AF062E80E860F94852BB7ee
ENVIO_START_BLOCK=66921819

# RPC cadangan. Tanpa ENVIO_API_TOKEN, set ENVIO_RPC_FOR=sync (lebih lambat: 100 blok per permintaan).
ENVIO_RPC_URL=https://testnet-rpc.monad.xyz
ENVIO_RPC_FOR=fallback

# --- Database indexer (Neon) — dipakai `envio start` / docker compose ---
# Pakai database TERPISAH dari api (mis. `envio`), karena Envio menjalankan DROP SCHEMA ... CASCADE saat reset.
# Pakai host langsung (tanpa "-pooler"): Envio dan Hasura butuh koneksi sesi, bukan PgBouncer mode transaksi.
# Kalau masih memakai `envio dev` (Postgres lokal), komentari baris ENVIO_PG_* supaya tidak menulis ke Neon.
ENVIO_PG_HOST=ep-xxxx.region.aws.neon.tech
ENVIO_PG_PORT=5432
ENVIO_PG_USER=
ENVIO_PG_PASSWORD=
ENVIO_PG_DATABASE=envio
ENVIO_PG_SSL_MODE=require
ENVIO_PG_PUBLIC_SCHEMA=public

# Hasura (GraphQL di atas tabel indexer) — database yang sama dengan ENVIO_PG_* di atas.
HASURA_GRAPHQL_DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/envio?sslmode=require
