# Salin ke packages/indexer/.env (gitignored). Envio hanya membaca variabel berawalan ENVIO_.
# Semua nilai di bawah punya default di config.yaml (GroupVault v1 di Monad testnet),
# jadi yang wajib diisi hanya ENVIO_API_TOKEN.

# HyperSync (sumber data utama). Gratis: https://envio.dev/app/api-tokens
ENVIO_API_TOKEN=

# Kontrak & chain — isi hanya kalau deploy ulang / pindah jaringan
ENVIO_CHAIN_ID=10143
ENVIO_GROUP_VAULT_ADDRESS=0x1467c9de54C1e4570AF062E80E860F94852BB7ee
ENVIO_START_BLOCK=66921819

# RPC cadangan. Tanpa ENVIO_API_TOKEN, set ENVIO_RPC_FOR=sync (lebih lambat: 100 blok per permintaan).
ENVIO_RPC_URL=https://testnet-rpc.monad.xyz
ENVIO_RPC_FOR=fallback
